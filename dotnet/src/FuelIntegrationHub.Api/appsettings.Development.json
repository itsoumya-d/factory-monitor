{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Database": {
    "EnsureCreated": true,
    "Seed": true,
    "DetailedErrors": true
  },
  "Security": {
    "ApiKey": "local-development-api-key-not-a-secret",
    "WebhookSecret": "local-development-webhook-secret-not-a-secret",
    "WebhookMaxSkewSeconds": 300
  }
}
