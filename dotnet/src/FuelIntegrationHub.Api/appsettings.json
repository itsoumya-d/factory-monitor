{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=fuel-integration.db"
  },
  "Database": {
    "EnsureCreated": false,
    "Seed": false,
    "DetailedErrors": false
  },
  "Security": {
    "ApiKey": "",
    "WebhookSecret": "",
    "WebhookMaxSkewSeconds": 300
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "Erp": {
    "Mode": "Simulated",
    "BaseUrl": "https://erp.example.com/",
    "TimeoutSeconds": 30
  }
}
